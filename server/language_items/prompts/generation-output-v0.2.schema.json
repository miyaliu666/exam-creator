{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fcc:language-item-generation-output:0.2",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["candidatePayload", "proposedScoringPackage"],
        "properties": {
          "candidatePayload": { "type": "object" },
          "proposedScoringPackage": {
            "type": "object",
            "required": ["scoringContractTemplateId"],
            "properties": {
              "scoringContractTemplateId": { "type": "string", "minLength": 1 },
              "correctOptionId": { "type": "string" },
              "correctMatches": { "type": "object", "additionalProperties": { "type": "string" } },
              "acceptedResponses": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
              "rubricId": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
