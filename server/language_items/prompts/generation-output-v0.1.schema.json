{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fcc:language-item-generation-output:0.1",
  "type": "object",
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["candidatePayload", "proposedCorrectOptionId"],
        "properties": {
          "candidatePayload": {
            "$ref": "urn:fcc:a1:single-select:0.2"
          },
          "proposedCorrectOptionId": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
