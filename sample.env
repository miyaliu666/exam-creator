MONGODB_URI_PRODUCTION=mongodb://127.0.0.1:27017/freecodecamp?directConnection=true
MONGODB_URI_STAGING=mongodb://127.0.0.1:27017/freecodecamp?directConnection=true

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# GitHub OAuth Redirect URL (optional)
GITHUB_REDIRECT_URL=http://127.0.0.1:8080/auth/callback/github
# Optional separate HTTPS SPA (for example GitHub Pages). Requires real GitHub OAuth.
# When set, GITHUB_REDIRECT_URL must be the public HTTPS BACKEND callback, MOCK_AUTH=false,
# and this origin is the only allowed cross-origin frontend (overrides ALLOWED_ORIGINS).
# FRONTEND_URL=https://your-name.github.io/exam-creator/

COOKIE_KEY="some_long_sixty-four byte stringsome_long_sixty-four byte string"
# SESSION_TTL_IN_S=43200
# SENTRY_DSN=""
# Sentry is optional in both debug and release; omit SENTRY_DSN when unused.

# CORS Origins: Comma-separated list of allowed origins (optional)
# Example: ALLOWED_ORIGINS=http://localhost:3000,https://myapp.com,https://staging.myapp.com
ALLOWED_ORIGINS=http://127.0.0.1:8080
PORT=8080

# VITE_MOCK_DATA=false
# MOCK_AUTH=false

# Explicit shared public workspace (optional, default false).
# Every visitor can edit as this existing author; no interactive login is shown.
# The author must already exist in the production ExamCreatorUser collection.
# This same-origin mode disables GitHub OAuth login and does not require
# GITHUB_CLIENT_ID/SECRET. Release session cookies require HTTPS, including IP URLs.
# Do not combine with MOCK_AUTH or FRONTEND_URL. Existing ownership is preserved.
# PUBLIC_ACCESS=true
# PUBLIC_USER_EMAIL=author@exam-creator.local

# Language Exam Item Creator AI (optional; defaults to deterministic offline mock)
# LANGUAGE_ITEM_AI_PROVIDER=deterministic-mock
# To enable DeepSeek, set the values below and raise REQUEST_TIMEOUT_IN_MS (for example 180000):
# LANGUAGE_ITEM_AI_PROVIDER=deepseek
# LANGUAGE_ITEM_AI_MODEL=your-approved-model-id
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek uses its OpenAI-compatible Chat Completions JSON mode.
# OpenAI Responses API remains available with LANGUAGE_ITEM_AI_PROVIDER=openai,
# OPENAI_API_KEY and optional OPENAI_BASE_URL=https://api.openai.com/v1.

# GitHub pull-request review for Language Exam Item Creator (optional)
# GITHUB_REVIEW_ENABLED=true
# GITHUB_REVIEW_REPOSITORY=owner/private-review-repository
# GITHUB_REVIEW_BASE_BRANCH=main
# GITHUB_REVIEW_TOKEN=
# GITHUB_REVIEW_API_BASE_URL=https://api.github.com
# Optional automatic PR-merge synchronization. Configure the same secret in the
# review repository webhook and send pull_request events to /api/integrations/github/webhook.
# GITHUB_REVIEW_WEBHOOK_SECRET=

# Required for the existing exam analytics integration, including release startup.
SUPABASE_URL=""
SUPABASE_KEY=""
